# Kopioi tämä tiedosto nimelle .env samaan kansioon ja täytä arvot.
# .env EI KOSKAAN mene gitiin.

# --- PostgreSQL ---
POSTGRES_DB=polar
POSTGRES_USER=polar
# Vain kirjaimia ja numeroita (upotetaan yhteysosoitteeseen):  openssl rand -hex 24
POSTGRES_PASSWORD=vaihda-tama

# Sovelluksen oma kantarooli. Ilman superuser-oikeuksia: se ei voi ajaa
# COPY ... FROM PROGRAM -komentoa, lukea palvelimen tiedostoja eikä luoda
# rooleja, mutta ajaa migraatiot normaalisti. POSTGRES_USER jää ylläpitoon
# (pg_dump, psql).
#
# ASETA MOLEMMAT TAI EI KUMPAAKAAN. Tyhjänä api käyttää superuseria kuten ennen.
# Salasana samoin vain kirjaimia ja numeroita:  openssl rand -hex 24
# Uusi asennus: rooli syntyy itsestään ensimmäisellä käynnistyksellä.
# Olemassa oleva kanta: aja kertaluonteinen siirto, ks. docs/JULKAISU.md.
DB_APP_USER=
DB_APP_PASSWORD=

# --- Backend (api) ---
# Kehityksessä: postgres://polar:polar@127.0.0.1:5432/polar  (127.0.0.1 eikä localhost: välttää IPv6-viiveen Windowsissa)
# Tuotannossa compose asettaa tämän automaattisesti (host = db)
DATABASE_URL=postgres://polar:vaihda-tama@127.0.0.1:5432/polar
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,api=debug,polar_client=debug

# JWT-allekirjoitusavain, vähintään 32 satunnaista merkkiä:  openssl rand -base64 48
JWT_SECRET=
# Istunnon kesto tunteina (JWT exp)
SESSION_HOURS=168
# Cookie Secure-lippu: tuotannossa true (HTTPS Cloudflaren takana), kehityksessä false (http://localhost)
COOKIE_SECURE=true
# 32 tavua base64:na Polar-tokenin salaamiseen levossa:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Ensimmäisellä käynnistyksellä luotava admin-käyttäjä (rekisteröinti on suljettu)
ADMIN_EMAIL=toni@example.com
ADMIN_PASSWORD=vaihda-tama

# --- Polar AccessLink (https://admin.polaraccesslink.com) ---
# Kehitys- ja tuotantoasiakkaalla on eri client id/secret ja eri redirect URL.
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# dev:  http://localhost:5173/api/polar/callback  (Vite dev serverin kautta, jotta istuntocookie kulkee mukana)
# prod: https://biometrics.tonikiuru.com/api/polar/callback
POLAR_REDIRECT_URL=http://localhost:5173/api/polar/callback
# Saako dataa lukea ilman kirjautumista (näyteikkuna). false = kaikki vaatii kirjautumisen.
PUBLIC_READ=true
# Näytetäänkö paino ja pituus myös kirjautumattomille. Oletus false = vain kirjautuneille.
PUBLIC_BODY_METRICS=false
# Synkronointiväli tunteina (0 = vain manuaalinen)
SYNC_INTERVAL_HOURS=6

# --- Imaget (vain tuotanto) ---
# CI julkaisee imaget GitHub Container Registryyn: <IMAGE_PREFIX>-api ja <IMAGE_PREFIX>-web.
# Oletus vastaa repoa Tonzium/biometrics. IMAGE_TAG=latest tai commitin lyhyt sha.
IMAGE_PREFIX=ghcr.io/tonzium/biometrics
IMAGE_TAG=latest

# --- Cloudflare Tunnel (vain tuotanto) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Etävarmuuskopio (deploy/backup.sh) -------------------------------------
# Ilman näitä varmuuskopio jää vain tälle koneelle, eli levyrikko tai
# kiristyshaittaohjelma vie sen mukanaan. Ks. docs/JULKAISU.md.
#
# Julkinen age-avain. Palvelin salaa kopiot tällä eikä voi purkaa niitä itse.
# Avainpari luodaan OMALLA koneella, ei palvelimella:
#   age-keygen -o backup.key     # tulostaa julkisen avaimen (age1...)
# Yksityinen avain (backup.key) talletetaan salasanojen hallintaan. Jos se
# katoaa, etäkopioita ei saa enää auki — paikalliset kopiot ovat salaamattomia.
BACKUP_AGE_RECIPIENT=
# rclone-kohde muodossa <remote>:<polku>. Kohde voi olla mikä tahansa rclonen
# tukema paikka; tunnukset annetaan alla RCLONE_CONFIG_*-muuttujina, joten
# erillistä rclone.conf-tiedostoa ei tarvita.
BACKUP_REMOTE=
# Montako päivää etäkopioita säilytetään (oletus 90)
BACKUP_REMOTE_KEEP_DAYS=90
#
# Esimerkki: Cloudflare R2 (S3-yhteensopiva, ilmainen taso riittää moninkertaisesti
# – pakattu dump on kilotavuja). Luo R2-ämpäri ja API-token, jolla on pääsy vain
# siihen ämpäriin, ja poista kommentit:
#BACKUP_REMOTE=offsite:polar-varmuuskopiot
#RCLONE_CONFIG_OFFSITE_TYPE=s3
#RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
#RCLONE_CONFIG_OFFSITE_REGION=auto
#RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
#RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
#
# Esimerkki: SFTP toiselle koneelle (avainpohjainen kirjautuminen)
#BACKUP_REMOTE=offsite:/varmuuskopiot/polar
#RCLONE_CONFIG_OFFSITE_TYPE=sftp
#RCLONE_CONFIG_OFFSITE_HOST=
#RCLONE_CONFIG_OFFSITE_USER=
#RCLONE_CONFIG_OFFSITE_KEY_FILE=/home/polar/.ssh/id_ed25519
